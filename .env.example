# 项目根目录（默认取仓库根目录，一般无需修改）
BASE_DIR=

# HuggingFace Token（pyannote 说话人分割需要，需先接受 pyannote/speaker-diarization-community-1 的模型协议）
# 也可以不填，改成在终端执行 hf auth login；模型下到 models/ 本地目录后则完全不需要凭据
HF_TOKEN=

# LLM（OpenAI 兼容端点；对话 Agent 需要支持 function calling 的模型）
# Kimi:
# LLM_API_KEY=sk-kimi-xxx
# LLM_API_BASE=https://api.kimi.com/coding/v1
# LLM_MODEL=kimi-for-coding
# LLM_TEMPERATURE=1        # Kimi 只接受 temperature=1
# DeepSeek:
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Qwen 示例：
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 国内网络可选用 HF 镜像（模型将经第三方镜像站下载）
# HF_ENDPOINT=https://hf-mirror.com

# 可选：模型与流水线参数
# DEEPFAKE_MODEL_NAME=eliya/forensics_0.3B_wavlm_oc_softmax_deepfake_classifier
# PARAFORMER_MODEL=paraformer-zh
# PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1
# SKIP_WARMUP=1            # 启动时不预热模型
