# 项目根目录（默认取仓库根目录，一般无需修改）
BASE_DIR=

# HuggingFace Token（pyannote 说话人分割需要，需先接受 pyannote/speaker-diarization 的模型协议）
HF_TOKEN=

# LLM（OpenAI 兼容端点；对话 Agent 需要支持 function calling 的模型）
# DeepSeek:
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Qwen 示例：
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 可选：模型与流水线参数
# WHISPER_MODEL_SIZE=base
# DEEPFAKE_MODEL_NAME=MelodyMachine/Deepfake-audio-detection-V2
# PYANNOTE_PIPELINE=pyannote/speaker-diarization
# SKIP_WARMUP=1   # 启动时不预热模型
